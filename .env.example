APP_NAME=SarafBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kabul

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Tenancy: one database for each Sarafi.
# TENANCY_ENABLED=false runs a single Sarafi on DB_* below (local work, tests).
# ---------------------------------------------------------------------------
TENANCY_ENABLED=true
# Addresses of the platform panel itself (comma separated). Every other address is a Sarafi.
CENTRAL_DOMAINS=localhost,127.0.0.1
# New Sarafis get <short-name>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=sarafbook.test
TENANT_DB_PREFIX=sb_
# true: a MySQL user for each Sarafi that can open only its own database
# (the central user then needs CREATE USER and GRANT OPTION)
TENANT_DB_CREATE_USER=false
TENANT_TRIAL_DAYS=14
TENANT_GRACE_DAYS=14

# MySQL server. With tenancy on, DB_HOST / DB_USERNAME / DB_PASSWORD are the defaults for the
# central database and for every tenant database; DB_DATABASE is used only when tenancy is off.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sarafbook
DB_USERNAME=root
DB_PASSWORD=
CENTRAL_DB_DATABASE=sarafbook_central

# Redis is recommended on the server for all three (SESSION_DRIVER=redis, CACHE_STORE=redis,
# QUEUE_CONNECTION=redis). "database" works everywhere without extra software.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp sender of the platform. A Sarafi can have its own key (platform panel).
WASENDER_API_URL=
WASENDER_API_KEY=

# Font of Dari and Pashto text: vazirmatn, noto-naskh-arabic or noto-kufi-arabic
FONT_DARI=vazirmatn
FONT_PASHTO=vazirmatn

# Address of the proxy in front of PHP when it is not on this server
# TRUSTED_PROXIES=127.0.0.1
