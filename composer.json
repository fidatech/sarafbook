{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fidatech/sarafbook",
    "type": "project",
    "description": "SarafBook: accounts, exchange and remittances for Sarafis. One code base, one database for each Sarafi.",
    "keywords": ["sarafi", "hawala", "exchange", "multi-tenant", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "intervention/image": "^3.11",
        "khaled.alshamaa/ar-php": "^7.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^3.1.70",
        "morilog/jalali": "^3.4",
        "mpdf/mpdf": "^8.3",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^6.25",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Tenancy/helpers.php",
            "app/Helpers/CurrencyHelper.php",
            "app/Helpers/WhatsAppHelper.php",
            "app/Helpers/activity_helper.php",
            "app/Helpers/amount.php",
            "app/Helpers/pages.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "assets": "@php tools/build-assets.php",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
